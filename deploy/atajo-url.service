# Servicio systemd: mantiene la API activa al cerrar SSH y tras reiniciar la instancia.
# Copiar a /etc/systemd/system/atajo-url.service
[Unit]
Description=Acortador de enlaces (FastAPI CLI) - Katalina Jaramillo
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/acortador-aws-katalina-jaramillo/backend
EnvironmentFile=/home/ec2-user/acortador-aws-katalina-jaramillo/backend/.env
ExecStart=/home/ec2-user/acortador-aws-katalina-jaramillo/backend/.venv/bin/fastapi run src/main.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

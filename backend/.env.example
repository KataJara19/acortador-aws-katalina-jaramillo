# Copiar a .env y ajustar los valores. NUNCA colocar access keys de AWS aquí:
# en EC2 Boto3 usa las credenciales temporales del rol IAM de la instancia.
APP_NAME=Atajo URL - Katalina Jaramillo
APP_ENV=development
AWS_REGION=us-east-1
DYNAMODB_TABLE=enlaces-cortos-katalina
# Local: http://localhost:8001 (DynamoDB local con moto_server).
# En EC2 / AWS dejar VACÍO para usar la tabla real.
DYNAMODB_ENDPOINT_URL=http://localhost:8001
# URL pública del backend (en EC2: http://<ip-publica-ec2>:8000)
PUBLIC_BASE_URL=http://localhost:8000
# Origen(es) de la interfaz web separados por coma (endpoint de S3 o CloudFront)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
MAX_URL_LENGTH=2048
